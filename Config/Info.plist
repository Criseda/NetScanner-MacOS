<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Keys Xcode cannot generate from build settings. Xcode merges this file
	with the Info.plist it generates (GENERATE_INFOPLIST_FILE).
-->
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>NetScanner looks for devices on your local network and checks which services they offer.</string>
	<!-- Advertised and browsed at launch to ask for Local Network access
	     before the first scan (LocalNetworkPermission in NetScannerKit). -->
	<key>NSBonjourServices</key>
	<array>
		<string>_netscanner._tcp</string>
	</array>
</dict>
</plist>
